{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "xbot.p27.trade-attempt.v1",
  "title": "P27 Trade Attempt DTO",
  "type": "object",
  "required": ["contract_version", "id", "intent_id", "strategy_type", "chain_id", "contract_address", "asset", "execution", "risk", "side", "status", "order"],
  "properties": {
    "contract_version": { "const": "p27.v1" },
    "id": { "$ref": "#/$defs/entityId" },
    "intent_id": { "$ref": "#/$defs/entityId" },
    "strategy_type": { "enum": ["fixed_ca", "dynamic_policy", "follow_discovery", "unknown"] },
    "chain_id": { "type": "string", "minLength": 1 },
    "contract_address": { "type": "string", "minLength": 1 },
    "asset": { "$ref": "#/$defs/asset" },
    "execution": { "$ref": "#/$defs/execution" },
    "risk": { "$ref": "#/$defs/risk" },
    "side": { "enum": ["buy", "sell", "strategy_create", "strategy_cancel"] },
    "status": { "type": "string", "minLength": 1 },
    "order": {
      "type": "object",
      "required": ["id", "provider_order_id", "tx_hash", "status"],
      "properties": {
        "id": { "$ref": "#/$defs/nullableEntityId" },
        "provider_order_id": { "type": ["string", "null"] },
        "tx_hash": { "type": ["string", "null"] },
        "status": { "type": ["string", "null"] }
      }
    }
  },
  "$defs": {
    "entityId": { "type": ["string", "number"] },
    "nullableEntityId": { "type": ["string", "number", "null"] },
    "asset": {
      "type": "object",
      "required": ["symbol", "name", "logo_url", "display_label", "metadata_source"],
      "properties": {
        "symbol": { "type": ["string", "null"] },
        "name": { "type": ["string", "null"] },
        "logo_url": { "type": ["string", "null"] },
        "display_label": { "type": "string", "minLength": 1 },
        "metadata_source": { "enum": ["signal_snapshot", "whitelist", "candidate", "gmgn_shared", "address_fallback"] }
      }
    },
    "execution": {
      "type": "object",
      "required": ["mode", "status", "intent_id", "attempt_id", "order_id", "tx_hash", "blockers"],
      "properties": {
        "mode": { "type": ["string", "null"] },
        "status": { "type": ["string", "null"] },
        "intent_id": { "$ref": "#/$defs/nullableEntityId" },
        "attempt_id": { "$ref": "#/$defs/nullableEntityId" },
        "order_id": { "$ref": "#/$defs/nullableEntityId" },
        "tx_hash": { "type": ["string", "null"] },
        "blockers": { "type": "array", "items": { "type": "string" } },
        "error": { "$ref": "#/$defs/tradeError" }
      }
    },
    "tradeError": {
      "type": ["object", "null"],
      "required": ["code", "user_message", "category", "source", "stage", "result", "order_created", "retry_allowed", "next_action"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "user_message": { "type": "string", "minLength": 1 },
        "category": { "enum": ["startup_blocker", "trade_gate", "local_execution", "provider_rejection", "provider_rate_limited", "provider_uncertain", "health_advisory", "unknown"] },
        "source": { "type": "string", "minLength": 1 },
        "stage": { "type": "string", "minLength": 1 },
        "provider_code": { "type": ["string", "null"] },
        "provider_message": { "type": ["string", "null"] },
        "http_status": { "type": ["integer", "null"] },
        "result": { "type": "string", "minLength": 1 },
        "order_created": { "type": "boolean" },
        "tx_hash": { "type": ["string", "null"] },
        "retry_allowed": { "type": "boolean" },
        "next_action": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "risk": {
      "type": "object",
      "required": ["warnings", "hard_failures"],
      "properties": {
        "warnings": { "type": "array", "items": { "type": "string" } },
        "hard_failures": { "type": "array", "items": { "type": "string" } }
      }
    }
  },
  "additionalProperties": true
}
