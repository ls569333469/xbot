# xbot environment template
# Copy this file to backend/.env and fill secrets locally or on the server.
# Never commit backend/.env, private keys, API tokens, passwords, or full wallet data.

# -----------------------------------------------------------------------------
# Runtime and service
# -----------------------------------------------------------------------------
BACKEND_PORT=3011
BACKEND_HOST=127.0.0.1
# Supervisor and production role commands set this explicitly. Leave blank in shared .env.
XBOT_PROCESS_ROLE=
TRADING_MODE=signal
LIVE_TRADING_ENABLED=false
ADMIN_TOKEN=
EMERGENCY_STOP=false
TRADE_ALERTS_VERIFIED=false
SIGNAL_MAX_AGE_SECONDS=300
# Protection-order reconciliation processes this many chain+wallet groups per cycle (1-4).
XBOT_STRATEGY_SYNC_GROUP_BUDGET=1

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=xbot
DB_USER=pm_user
DB_PASSWORD=

# -----------------------------------------------------------------------------
# GMGN credentials
# -----------------------------------------------------------------------------
# primary = production/server credentials.
# test = isolated local testing credentials.
# The active profile selects exactly one pair below; no fallback to the other pair.
GMGN_CREDENTIAL_PROFILE=primary

# Primary / production GMGN API pair
GMGN_API_KEY=
# Use a one-line PEM value with escaped \n when required by the deployment tool.
GMGN_PRIVATE_KEY=

# Test-only GMGN API pair: fill these two fields for local testing.
# Keep GMGN_CREDENTIAL_PROFILE=test only on the isolated test process/machine.
GMGN_TEST_API_KEY=
GMGN_TEST_PRIVATE_KEY=

# Set true only after confirming the selected key pair is exclusive to this deployment.
GMGN_KEY_EXCLUSIVE=false
GMGN_API_HOST=https://openapi.gmgn.ai

# -----------------------------------------------------------------------------
# GMGN cache, candidate freshness, and request pressure
# -----------------------------------------------------------------------------
P22_GMGN_SHARED_LIMIT_ENABLED=true
# Keep this scope identical on all xbot roles/hosts sharing the same GMGN quota.
P22_GMGN_RATE_SCOPE=gmgn:https://openapi.gmgn.ai
GMGN_FAST_CACHE_TTL_MS=5000
GMGN_WALLET_CACHE_TTL_MS=60000
GMGN_TOKEN_CACHE_TTL_MS=3600000
# Persisted chain wallet balances are advisory; this TTL only controls freshness labels.
CHAIN_READINESS_BALANCE_TTL_MS=300000
CHAIN_RPC_ADVISORY_TIMEOUT_MS=500
P20_GMGN_CANDIDATE_TTL_MS=300000
# P33 read-only historical replay pacing. Cached windows bypass these waits.
KOL_PERFORMANCE_GMGN_GLOBAL_INTERVAL_MS=1000
KOL_PERFORMANCE_GMGN_CA_INTERVAL_MS=2000

# -----------------------------------------------------------------------------
# GMGN chain execution reserves
# -----------------------------------------------------------------------------
GMGN_MAX_FEE_RESERVE_SOL=0.0002
GMGN_MAX_FEE_RESERVE_BSC=0.001
GMGN_MAX_FEE_RESERVE_BASE=0.0005
GMGN_MAX_FEE_RESERVE_ETH=0.002
GMGN_MAX_FEE_RESERVE_ROBINHOOD=
GMGN_MIN_GAS_RESERVE_SOL=0.01
GMGN_MIN_GAS_RESERVE_BSC=0.005
GMGN_MIN_GAS_RESERVE_BASE=0.002
GMGN_MIN_GAS_RESERVE_ETH=0.01
GMGN_MIN_GAS_RESERVE_ROBINHOOD=

# -----------------------------------------------------------------------------
# Chain RPC endpoints
# -----------------------------------------------------------------------------
SOLANA_RPC_URL=https://api.mainnet.solana.com
BSC_RPC_URL=https://bsc-dataseed.bnbchain.org
BASE_RPC_URL=https://mainnet.base.org
ETH_RPC_URL=https://ethereum-rpc.publicnode.com
ROBINHOOD_RPC_URL=

# -----------------------------------------------------------------------------
# X provider and 6551 monitoring
# -----------------------------------------------------------------------------
# Production provider is 6551. Other providers require the explicit legacy flag.
X_DATA_PROVIDER=6551
OPENNEWS_TOKEN=
X_6551_TIMEOUT_MS=15000
X_6551_WSS_ENABLED=true
X_6551_WATCH_APPLY_ENABLED=true
X_6551_WATCH_UNFOLLOW_ENABLED=false
X_6551_HEARTBEAT_MS=20000
X_6551_RECONNECT_MAX_MS=1000
X_6551_PENDING_RETRY_MS=30000
X_6551_MONTHLY_MESSAGE_LIMIT=2000000

# -----------------------------------------------------------------------------
# P21 follow discovery and Grok research
# -----------------------------------------------------------------------------
# Follow Discovery is independently staged and defaults to disabled.
P21_FOLLOW_DISCOVERY_ENABLED=false
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-4.5
XAI_PROXY_URL=
XAI_REASONING_EFFORT=low
XAI_RESEARCH_TIMEOUT_MS=60000
XAI_FOLLOW_TIMEOUT_MS=60000

# P34 read-only KOL research sampling and provider pacing.
KOL_PERFORMANCE_X_SEGMENT_DAYS=7
KOL_PERFORMANCE_X_MAX_REQUESTS=16
KOL_PERFORMANCE_X_REQUEST_INTERVAL_MS=2500
KOL_PERFORMANCE_GROK_MAX_POSTS=10
KOL_PERFORMANCE_FOLLOW_MAX_SOURCE_EVENTS=100
KOL_PERFORMANCE_FOLLOW_MAX_RESEARCH_EVENTS=20
KOL_PERFORMANCE_FOLLOW_XAI_INTERVAL_MS=2500
KOL_PERFORMANCE_GMGN_GLOBAL_INTERVAL_MS=1000
KOL_PERFORMANCE_GMGN_CA_INTERVAL_MS=2000

# -----------------------------------------------------------------------------
# P20 feature switches
# -----------------------------------------------------------------------------
P20_CANDIDATE_INDEX_ENABLED=false
P20_DYNAMIC_RESOLUTION_ENABLED=false
P20_RECORD_ENABLED=false
P20_PAPER_ENABLED=false
P20_LIVE_ENABLED=false

# -----------------------------------------------------------------------------
# Legacy and optional providers
# -----------------------------------------------------------------------------
XBOT_LEGACY_X_PROVIDERS_ENABLED=false
XBOT_LEGACY_PAPER_ENABLED=false
XBOT_LEGACY_SHADOW_ENABLED=false
SHADOW_LIVE_ENABLED=false
SOCIALDATA_API_KEY=
TWITTERAPI_IO_API_KEY=
TWITTERAPI_IO_FOLLOW_INTERVAL_MS=60000
TWITTERAPI_IO_MIN_INTERVAL_MS=6000
TWITTERAPI_IO_DAILY_CREDIT_LIMIT=50000
TWITTERAPI_IO_CREDIT_WARNING_PCT=80
TWITTERAPI_IO_MAX_PAGES=100
TWITTERAPI_IO_FOLLOW_INCREMENTAL_MAX_PAGES=5
TWITTERAPI_IO_TIMEOUT_MS=15000
TWITTER_STREAM_ENABLED=false
TWITTERAPI_IO_WEBHOOK_SECRET=
TWITTER_WEBHOOK_MAX_AGE_MS=600000
